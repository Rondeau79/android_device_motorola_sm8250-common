/(vendor|system/vendor)/bin/vl53l1_daemon               u:object_r:vl53l1_exec:s0

# IFAA
/(vendor|system/vendor)/bin/hw/vendor\.zui\.hardware\.ifaa@1\.0-service                 u:object_r:hal_ifaa_default_exec:s0

# LiveDisplay
/(vendor|system/vendor)/bin/hw/vendor\.lineage\.livedisplay@2\.1-service\.moto_kona     u:object_r:hal_lineage_livedisplay_qti_exec:s0

# Touch
/(vendor|system/vendor)/bin/hw/vendor\.lineage\.touch@1\.0-service\.moto_kona           u:object_r:hal_lineage_touch_default_exec:s0

# ZRAM
/data/per_boot(/.*)?                                            u:object_r:per_boot_file:s0
